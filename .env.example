# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (self-hosted, see docs/DATABASE.md)
# Local: run `supabase start`, then copy API_URL / ANON_KEY / SERVICE_ROLE_KEY / JWT_SECRET
# from `supabase status -o env`. On your server, use the values from its docker/.env.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (server-side, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Production only: cookie domain shared across subdomains (default .himanshurawat.in)
# AUTH_COOKIE_DOMAIN=.himanshurawat.in

# Optional Cloudflare Turnstile protection. Configure both values together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Cloudflare R2
R2_ACCOUNT_ID=your-r2-account-id
# lib/r2Config.ts and the worker use R2_ENDPOINT (worker falls back to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=https://your-r2-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket
R2_PUBLIC_BASE_URL=https://your-public-r2-domain

# AI
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GROQ_API_KEY=your-groq-api-key

# Encryption (for API key storage - min 32 characters)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Email/notifications
RESEND_API_KEY=your-resend-api-key
# Sender for follow-ups and the morning digest. A bare address gets the
# "NextMilestone" display name automatically; set the full form in each environment.
FOLLOW_UP_FROM_EMAIL="NextMilestone <hello@himanshurawat.in>"

# Analytics/other (optional)
POSTHOG_API_KEY=your-posthog-key
POSTHOG_HOST=https://us.i.posthog.com

# Background worker (worker/, see worker/README.md)
# Direct/session-mode Postgres connection (LISTEN/NOTIFY needs it; not the 6543 pooler).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Per-type slots and hard timeouts (seconds); merged with defaults
WORKER_CONCURRENCY=render_pdf=2,fetch_jobs=1
WORKER_TIMEOUTS=render_pdf=30,fetch_jobs=300,fetch_watchlist=600
WORKER_POLL_INTERVAL=10
WORKER_BACKOFF_BASE=30
# Internal HTTP (/health, /preview) - never expose publicly
WORKER_HTTP_HOST=127.0.0.1
WORKER_HTTP_PORT=8787
# Worker internal HTTP (live Typst preview proxy: /api/documents/:id/preview -> WORKER_URL/preview)
WORKER_URL=http://127.0.0.1:8787
# Typst templates dir (default <repo>/templates/typst; the worker image uses /app/templates/typst)
# TYPST_TEMPLATES_DIR=

# Job sources (worker, all optional). A source whose key is missing is skipped with
# errors[source] = "missing API key". Keyless sources (Arbeitnow, Bundesagentur,
# MyCareersFuture, Remotive, Remote OK, Himalayas, Jobicy) need nothing here.
# Adzuna: https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble: https://jooble.org/api/about
JOOBLE_API_KEY=
# Reed (UK): https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=
# USAJOBS: https://developer.usajobs.gov/apirequest/ (USER_AGENT = the email you registered with)
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
# Source gates (PRD area 9, both default off). LinkedIn, Glassdoor and Indeed via JobSpy
# stay off in production because their terms restrict scraping; India-only boards
# (Naukri, Instahyre, Cutshort) are opt-in. See lib/jobs/sourceRegistry.ts.
ENABLE_TOS_RESTRICTED_SOURCES=false
ENABLE_INDIA_SOURCES=false
# Shared US company watchlist (fetch_watchlist task, pg_cron every 15 min). Fan-out and
# polling intervals live in the job_supply_settings table, not in env. Re-seed with
#   cd worker && uv run python -m orbithire_worker.watchlist_seed --apply
# Tier 3 scrapers (Wellfound, Instahyre, Cutshort, SEEK): opt-in per search, robots.txt-respecting,
# tiny volume. Kill switch (default true) and a comma list of scrapers to turn off.
# SEEK is shipped blocked (needs a browser) and is always skipped.
JOB_SCRAPERS_ENABLED=true
# SCRAPER_DISABLE=seek,wellfound

# Ranking + morning digest (worker). Uses OPENAI_API_KEY (embeddings), ANTHROPIC_API_KEY / OPENAI_API_KEY (scoring),
# ENCRYPTION_KEY (user API keys), RESEND_API_KEY + FOLLOW_UP_FROM_EMAIL (digest) and NEXT_PUBLIC_APP_URL (links).
# Platform-key LLM scoring: quota (default, only while free generations remain) | always | never
RANKING_PLATFORM_LLM=quota
RANKING_PLATFORM_DAILY_LIMIT=15
# DIGEST_FROM_EMAIL=

# MCP OAuth (optional): pin the OAuth issuer / token audience origin (default: from X-Forwarded-Host / Host)
# OAUTH_ISSUER=https://dashboard.example.com
# OAUTH_SIGNING_SECRET=

# Owner admin account (seeded by migration 20261024000101). Used only by
# `npm run owner:set-temp-password` to set a temporary password (12+ characters);
# the owner must change it at first sign-in. Never commit a real value.
# OWNER_TEMP_PASSWORD=
# OWNER_EMAIL=hello@himanshurawat.in

# Google Calendar (optional, PRD area 5). The calendar card and sync stay hidden unless both
# client values are set. Create an OAuth "Web application" client in Google Cloud, enable the
# Calendar API, and add <NEXT_PUBLIC_APP_URL>/api/calendar/google/callback as a redirect URI.
# Scopes: openid, email, calendar.events.readonly (read events), calendar.app.created (write
# only to the NextMilestone calendar we create). Both calendar scopes need Google verification.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Optional override; defaults to <NEXT_PUBLIC_APP_URL>/api/calendar/google/callback
# GOOGLE_CALENDAR_REDIRECT_URI=

# Pricing and billing (PRD area 10, Stripe). Leave empty to keep billing off: the
# Billing tab and checkout are hidden and everyone gets Free plan rules (own-key users
# keep unlimited AI). Turn on by setting all five. Prices must match lib/billing/prices.ts.
# Webhook endpoint: <app url>/api/billing/webhook, events: checkout.session.completed,
# customer.subscription.created/updated/deleted, invoice.upcoming.
NEXT_PUBLIC_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
