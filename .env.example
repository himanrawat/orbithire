# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (self-hosted, see docs/DATABASE.md)
# Local: run `supabase start`, then copy API_URL / ANON_KEY / SERVICE_ROLE_KEY / JWT_SECRET
# from `supabase status -o env`. On your server, use the values from its docker/.env.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (server-side, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Production only: cookie domain shared across subdomains (default .himanshurawat.in)
# AUTH_COOKIE_DOMAIN=.himanshurawat.in

# Cloudflare R2
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket
R2_PUBLIC_BASE_URL=https://your-public-r2-domain

# AI
OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key

# Encryption (for API key storage - min 32 characters)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Email/notifications
RESEND_API_KEY=your-resend-api-key
FOLLOW_UP_FROM_EMAIL=notifications@yourdomain.com

# Analytics/other (optional)
POSTHOG_API_KEY=your-posthog-key
POSTHOG_HOST=https://us.i.posthog.com
